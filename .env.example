# Local env for analytics tagging (never commit `.env.local` with prod secrets).

# GA4 Measurement ID (e.g., G-XXXX). When set alone, wires gtag + manual page_view.
VITE_GA_MEASUREMENT_ID=

# Prefer GTM? Provide container id (e.g., GTM-XXXX) — still mirrors custom events onto dataLayer in devtools.
VITE_GTM_CONTAINER_ID=
